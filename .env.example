# Required: SEC EDGAR will block requests without a valid User-Agent.
# Format must be "CompanyName contact@email.com" per SEC fair-access policy.
# See: https://www.sec.gov/developer
SEC_USER_AGENT="YourName your@email.com"

# Optional: override the default data root (defaults to ./data relative to project root)
# DATA_ROOT=/path/to/your/data
